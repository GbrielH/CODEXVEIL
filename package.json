{
  "name": "codexveil",
  "version": "0.1.0",
  "private": true,
  "description": "Codexveil — plataforma de gerenciamento de campanhas de RPG de mesa.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@codexveil/web",
    "dev:mobile": "pnpm --filter @codexveil/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:assets": "node scripts/generate-brand-assets.ts",
    "db:types": "pnpm --filter @codexveil/database run db:types"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "turbo": "^2.11.8",
    "typescript": "catalog:"
  }
}

# Copie para apps/web/.env.local e preencha com os dados do seu projeto Supabase.
# Somente valores PÚBLICOS: nunca coloque a chave secreta (service_role / sb_secret_) aqui.

# Project Settings > API > Project URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API Keys > Publishable key (sb_publishable_...) ou a antiga anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site (usada em links de e-mail e redirecionamentos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Copie para apps/mobile/.env.local e preencha com os dados do seu projeto Supabase.
# Somente valores PÚBLICOS: nunca coloque a chave secreta (service_role / sb_secret_) no app.

# URL do projeto. No emulador Android, o Supabase local fica em http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) ou a antiga anon key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço do site (links de convite e de recuperação de senha abrem no navegador)
EXPO_PUBLIC_SITE_URL=http://localhost:3000

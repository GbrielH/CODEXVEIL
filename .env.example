# =============================================================================
# Codexveil — variáveis de ambiente (somente NOMES; nunca versione valores reais)
#
# Cada app lê o próprio arquivo:
#   apps/web/.env.local     (modelo: apps/web/.env.example)
#   apps/mobile/.env.local  (modelo: apps/mobile/.env.example)
#
# Todas as variáveis abaixo são PÚBLICAS por natureza (vão para o navegador/app).
# A chave secreta do Supabase (service_role / sb_secret_...) NUNCA deve aparecer em
# nenhum destes arquivos: os apps recusam iniciar com ela e o RLS dispensa seu uso.
# =============================================================================

# --- Web (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# --- Build do app Android (opcional, usado por apps/mobile/app.config.ts) ---
# O projectId do EAS fica no próprio app.config.ts (não é segredo).
# ANDROID_PACKAGE=app.codexveil.mobile
